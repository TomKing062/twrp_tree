# TWRP recovery USB configfs
# adb + mtp + sideload + fastbootd

# For common rc

on init

    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mkdir /dev/usb-ffs/fastboot 0770 root root



on fs

    mount configfs none /config

    mkdir /config/usb_gadget/g1 0770 root root


    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4EE7


    mkdir /config/usb_gadget/g1/strings/0x409 0770 root root

    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}

    write /config/usb_gadget/g1/strings/0x409/manufacturer "TWRP"

    write /config/usb_gadget/g1/strings/0x409/product "Recovery"


    mkdir /config/usb_gadget/g1/configs/b.1 0770 root root

    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 root root


    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "Android Recovery"

    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    write /config/usb_gadget/g1/configs/b.1/bmAttributes 0xc0



    # ADB FunctionFS

    mkdir /config/usb_gadget/g1/functions/ffs.adb 0770 root root

    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000



    # MTP

    mkdir /config/usb_gadget/g1/functions/ffs.mtp 0770 root root

    mount functionfs mtp /dev/usb-ffs/mtp uid=1024,gid=1024



    # fastbootd

    mkdir /config/usb_gadget/g1/functions/ffs.fastboot 0770 root root

    mount functionfs fastboot /dev/usb-ffs/fastboot uid=0,gid=0



    setprop sys.usb.controller ${sys.usb.controller}



on boot

    setprop sys.usb.config adb



#################################
# NONE
#################################

on property:sys.usb.config=none

    write /config/usb_gadget/g1/UDC none

    stop adbd

    stop twrpmtp

    stop fastbootd



#################################
# ADB
#################################


on property:sys.usb.config=adb


    write /config/usb_gadget/g1/UDC none


    rm /config/usb_gadget/g1/configs/b.1/f1


    start adbd



on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb


    write /config/usb_gadget/g1/idVendor 0x18d1

    write /config/usb_gadget/g1/idProduct 0x4EE7


    symlink /config/usb_gadget/g1/functions/ffs.adb \
    /config/usb_gadget/g1/configs/b.1/f1


    write /config/usb_gadget/g1/UDC ${sys.usb.controller}


    setprop sys.usb.state adb





#################################
# MTP
#################################


on property:sys.usb.config=mtp


    write /config/usb_gadget/g1/UDC none


    start twrpmtp



on property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.config=mtp


    write /config/usb_gadget/g1/idVendor 0x18d1

    write /config/usb_gadget/g1/idProduct 0x4EE1


    symlink /config/usb_gadget/g1/functions/ffs.mtp \
    /config/usb_gadget/g1/configs/b.1/f1


    write /config/usb_gadget/g1/UDC ${sys.usb.controller}


    setprop sys.usb.state mtp





#################################
# MTP + ADB
#################################


on property:sys.usb.config=mtp,adb


    write /config/usb_gadget/g1/UDC none


    start adbd

    start twrpmtp



on property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.config=mtp,adb


    write /config/usb_gadget/g1/idVendor 0x18d1

    write /config/usb_gadget/g1/idProduct 0x4EE2



    symlink /config/usb_gadget/g1/functions/ffs.mtp \
    /config/usb_gadget/g1/configs/b.1/f1



    symlink /config/usb_gadget/g1/functions/ffs.adb \
    /config/usb_gadget/g1/configs/b.1/f2



    write /config/usb_gadget/g1/UDC ${sys.usb.controller}


    setprop sys.usb.state mtp,adb





#################################
# ADB SIDELOAD
#################################


on property:sys.usb.config=sideload


    stop adbd


    write /config/usb_gadget/g1/UDC none


    write /config/usb_gadget/g1/idVendor 0x18d1

    write /config/usb_gadget/g1/idProduct 0xd00d



    start adbd



on property:sys.usb.ffs.ready=1 && property:sys.usb.config=sideload


    symlink /config/usb_gadget/g1/functions/ffs.adb \
    /config/usb_gadget/g1/configs/b.1/f1


    write /config/usb_gadget/g1/UDC ${sys.usb.controller}


    setprop sys.usb.state sideload





#################################
# FASTBOOTD
#################################


on property:sys.usb.config=fastboot


    stop adbd

    stop twrpmtp


    write /config/usb_gadget/g1/UDC none


    start fastbootd



on property:sys.usb.ffs.fastboot.ready=1 && property:sys.usb.config=fastboot


    write /config/usb_gadget/g1/idVendor 0x18d1

    write /config/usb_gadget/g1/idProduct 0x4EE0



    symlink /config/usb_gadget/g1/functions/ffs.fastboot \
    /config/usb_gadget/g1/configs/b.1/f1



    write /config/usb_gadget/g1/UDC ${sys.usb.controller}


    setprop sys.usb.state fastboot