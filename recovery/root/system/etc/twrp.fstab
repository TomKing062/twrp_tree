# Bootloader, AVB, and boot chain partitions
/spl                  emmc    /dev/block/spl_a          flags=backup=1;display="SPL"
/spl_bk               emmc    /dev/block/spl_b          flags=backup=1;display="SPL Backup"
/uboot                emmc    /dev/block/by-name/uboot         flags=slotselect;backup=1;display="U-Boot"
/sml                  emmc    /dev/block/by-name/sml           flags=slotselect;backup=1;display="SML"
/tos                  emmc    /dev/block/by-name/trustos       flags=slotselect;backup=1;display="TrustOS"
/teecfg               emmc    /dev/block/by-name/teecfg        flags=slotselect;backup=1;display="TEE Config"
/vbmeta               emmc    /dev/block/by-name/vbmeta        flags=slotselect;backup=1;flashimg=1;display="VBMeta"
/vbmeta_system        emmc    /dev/block/by-name/vbmeta_system flags=slotselect;backup=1;flashimg=1;display="VBMeta System"
/vbmeta_vendor        emmc    /dev/block/by-name/vbmeta_vendor flags=slotselect;backup=1;flashimg=1;display="VBMeta Vendor"
/vbmeta_product       emmc    /dev/block/by-name/vbmeta_product flags=slotselect;backup=1;flashimg=1;display="VBMeta Product"
/vbmeta_odm           emmc    /dev/block/by-name/vbmeta_odm    flags=slotselect;backup=1;flashimg=1;display="VBMeta ODM"
/dtbo                 emmc    /dev/block/by-name/dtbo          flags=slotselect;backup=1;flashimg=1;display="DTBO"

# Boot images
/boot                 emmc    /dev/block/by-name/boot          flags=slotselect;backup=1;flashimg=1;display="Boot"
/vendor_boot          emmc    /dev/block/by-name/vendor_boot   flags=slotselect;backup=1;flashimg=1;display="Vendor Boot"

# Modem, DSP, and radio firmware partitions
/ltedsp               emmc    /dev/block/by-name/l_ldsp        flags=slotselect;backup=1;display="LTE DSP"
/ltegdsp              emmc    /dev/block/by-name/l_gdsp        flags=slotselect;backup=1;display="LTE GDSP"
/ltemodem             emmc    /dev/block/by-name/l_modem       flags=slotselect;backup=1;display="LTE Modem"
/ltefixnv1            emmc    /dev/block/by-name/l_fixnv1      flags=backup=1;display="LTE FixNV1"
/ltefixnv2            emmc    /dev/block/by-name/l_fixnv2      flags=backup=1;display="LTE FixNV2"
/lteruntimenv1        emmc    /dev/block/by-name/l_runtimenv1  flags=backup=1;display="LTE RuntimeNV1"
/lteruntimenv2        emmc    /dev/block/by-name/l_runtimenv2  flags=backup=1;display="LTE RuntimeNV2"
/wcnmodem             emmc    /dev/block/by-name/wcnmodem      flags=slotselect;backup=1;display="WCN Modem"
/gnssmodem            emmc    /dev/block/by-name/gnssmodem     flags=slotselect;backup=1;display="GNSS Modem"
/pmsys                emmc    /dev/block/by-name/pm_sys        flags=slotselect;backup=1;display="PM Sys"

# Misc and vendor-specific physical partitions
/misc                 emmc    /dev/block/by-name/misc          flags=backup=1;display="Misc"
/persist              emmc    /dev/block/by-name/persist       flags=backup=1;display="Persist"
/logo                 emmc    /dev/block/by-name/logo          flags=backup=1;display="Logo"
/fbootlogo            emmc    /dev/block/by-name/fbootlogo     flags=backup=1;display="Fastboot Logo"
/super                emmc    /dev/block/by-name/super         flags=display="Super"
/ztecfg               emmc    /dev/block/by-name/ztecfg        flags=backup=1;display="ZTE Config"
/mnt/vendor           ext4    /dev/block/by-name/prodnv        flags=wait;check;backup=1;display="ProdNV"

# Dynamic partitions
system                /system erofs                            ro wait,logical,slotselect,backup=1,display="System"
system                /system ext4                             ro,barrier=1 wait,logical,slotselect,backup=1,display="System"
/system_ext           erofs   system_ext                       flags=wait;logical;slotselect;backup=1;display="SystemExt"
/vendor               erofs   vendor                           flags=wait;logical;slotselect;backup=1;display="Vendor"
/odm                  erofs   odm                              flags=wait;logical;slotselect;backup=1;display="ODM"
/product              erofs   product                          flags=wait;logical;slotselect;backup=1;display="Product"
/vendor_dlkm          erofs   vendor_dlkm                      flags=wait;logical;slotselect;backup=1;display="Vendor DLKM"

# Data and cache
/metadata             f2fs    /dev/block/by-name/metadata      flags=wait;check;formattable;display="Metadata"
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier wait,quota,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,formattable,backup=1,display="Data"
/cache                ext4    /dev/block/by-name/cache         flags=wait;check;formattable;backup=1;display="Cache"

# External storage
/external_sd          vfat    /dev/block/mmcblk1p1             flags=wait;storage;removable;display="MicroSD"
/usb_otg              vfat    /dev/block/sda1                  flags=wait;storage;removable;display="USB-OTG"
